    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1",
    "multer": "^2.1.1",
    "next": "^14.2.35",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "pdf-lib": "^1.17.1",

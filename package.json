{
  "name": "elearning-epa-unified",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsx watch src/server/server.ts\"",
    "dev:next": "next dev",
    "dev:server": "tsx watch src/server/server.ts",
    "build": "next build",
    "start": "next start",
    "server": "tsx src/server/server.ts",
    "seed:demo": "tsx scripts/seed-demo.ts seed",
    "seed:demo:remove": "tsx scripts/seed-demo.ts remove",
    "seed:lessons": "tsx scripts/seed-demo.ts lessons",
    "seed:lessons:remove": "tsx scripts/seed-demo.ts remove-lessons",
    "test": "npm run test:node && npm run test:unit && npm run test:integration",
    "test:node": "node --import tsx --test test/*.test.ts test/*.test.js",
    "test:unit": "vitest run tests/unit",
    "test:integration": "jest --runInBand",
    "test:a11y": "node --import tsx --test test/a11y.test.tsx",
    "lint": "eslint",
    "audit:lock": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1",
    "multer": "^2.1.1",
    "next": "^15.5.19",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pino": "^8.18.0",
    "pino-http": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.1",
    "rotating-file-stream": "^3.0.5",
    "xss-clean": "^0.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "concurrently": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.19",
    "eslint-plugin-security": "^4.0.0",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^10.1.0",
    "postcss": "^8.5.15",
    "retire": "^5.4.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "eslint-config-next": {
      "glob": "^10.4.5"
    },
    "next": {
      "postcss": "^8.5.15"
    }
  }
}

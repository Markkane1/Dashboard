# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env.local (for local development) or configure in production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication (NextAuth / Next.js)
# ------------------------------------------------------------------------------
# Generate a secure 32-character secret using: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-plus-character-secret
# NEXTAUTH_SECRET is an optional alias. If both are set, they must match.
NEXTAUTH_SECRET=replace-with-a-random-32-plus-character-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials (for learner/instructor login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Domain Allow-List (comma-separated, e.g., punjab.gov.pk,epa.punjab.gov.pk)
# Users whose email domain matches this list are approved automatically.
# Other domains will register with a status of 'pending' and require admin approval.
OAUTH_ALLOWED_DOMAINS=punjab.gov.pk,epa.punjab.gov.pk

# Cloudflare Turnstile CAPTCHA (Authentication and signup protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ------------------------------------------------------------------------------
# 2. Express Backend API Service
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/elearning
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URLs (shared client-server values)
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. Transactional Email Provider
# ------------------------------------------------------------------------------
# Supported values: resend | sendgrid | smtp | console
# If not set, the app will auto-detect from active API keys, falling back to 'console' (dev logs).
EMAIL_PROVIDER=console
EMAIL_FROM="EPA Punjab eLearning <no-reply@epa.punjab.gov.pk>"

# Resend Service configuration
RESEND_API_KEY=

# SendGrid Service configuration
SENDGRID_API_KEY=

# SMTP Server configuration (For custom local government relays)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 4. Protected Video Storage & Streaming
# ------------------------------------------------------------------------------
# Video storage driver. Supported: local (default)
VIDEO_STORAGE=local
# Local absolute or relative directory where videos are stored on disk.
LOCAL_VIDEO_DIR=uploads/videos

# Future remote storage extension points. Leave blank while VIDEO_STORAGE=local.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Video Upload Constraints
# Size limit for video uploads in bytes. Default: 524288000 (500MB)
VIDEO_MAX_UPLOAD_SIZE_BYTES=524288000

# Video Streaming Constraints (Range requests)
VIDEO_DEFAULT_CHUNK_BYTES=1048576
VIDEO_MAX_CHUNK_BYTES=5242880
MAX_CONCURRENT_VIDEO_STREAMS=25

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting Controls
# ------------------------------------------------------------------------------
# General API rate limiting (per IP)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Auth route rate limiting (login, password reset)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Browser client log ingestion rate limiting (per IP)
CLIENT_LOG_RATE_LIMIT_WINDOW_MS=60000
CLIENT_LOG_RATE_LIMIT_MAX=30

# User Lockout parameters
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MS=900000

# ------------------------------------------------------------------------------
# 6. Test Environment Overrides
# ------------------------------------------------------------------------------
# Optional: use a fixed MongoDB instance instead of mongodb-memory-server.
TEST_MONGODB_URI=
# Optional: use a local MongoDB binary when mongodb-memory-server cannot download one.
MONGOMS_SYSTEM_BINARY=
